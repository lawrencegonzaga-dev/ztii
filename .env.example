# ZTII environment configuration
# Copy this file to .env and adjust values for your deployment.
# The app does not load .env automatically; export these variables
# in your shell or deployment environment.

# ------------------------------------------------------------------
# API / dashboard (start.py combined launcher)
# ------------------------------------------------------------------

# Port for the FastAPI backend launched by start.py
ZTII_API_PORT=8000

# Port for the Streamlit dashboard launched by start.py
PORT=8501

# Base URL the dashboard uses to reach the backend API
ZTII_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------

# SQLite database file location
ZTII_DATABASE_PATH=database/ztii.db

# ------------------------------------------------------------------
# Offline sync worker
# ------------------------------------------------------------------

# Start the background sync worker with the API (true/false)
ZTII_ENABLE_SYNC_WORKER=false

# Seconds between sync worker passes
SYNC_INTERVAL_SECONDS=5

# ------------------------------------------------------------------
# Device connectivity thresholds (backend/services/device_status.py)
# ------------------------------------------------------------------

# Seconds after the last telemetry before a device is shown as Stale
ZTII_STALE_AFTER_SECONDS=30

# Seconds after the last telemetry before a device is shown as Offline.
# Must be greater than ZTII_STALE_AFTER_SECONDS.
ZTII_OFFLINE_AFTER_SECONDS=120

# ------------------------------------------------------------------
# PLC / Modbus TCP (backend/services/modbus_client.py)
# ------------------------------------------------------------------

PLC_HOST=127.0.0.1
PLC_PORT=5020
PLC_UNIT_ID=1

# ------------------------------------------------------------------
# Device authentication (backend/services/device_auth.py)
# ------------------------------------------------------------------

# JSON map of device_id -> pre-shared key. Required by device-facing
# write routes; the API fails closed (503) when this is unset, empty,
# or malformed.
# Example: {"ESP32-001": "change-me-key-001", "ESP32-002": "change-me-key-002"}
ZTII_DEVICE_KEYS_JSON=

# Single-key fallback used by the hardware simulator for its one device.
# Ignored when ZTII_DEVICE_KEYS_JSON contains an entry for that device.
ZTII_DEVICE_KEY=
